{
  "name": "repetition-spotter",
  "description": "Professional tool for detecting and analyzing text repetitions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.11.0",
    "yarn": ">=1.22.19"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "pre-build": "yarn lint && yarn type-check",
    "build:safe": "yarn pre-build && yarn build",
    "start": "next start"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "mammoth": "^1.13.0",
    "marked": "^16.4.2",
    "next": "15.5.29",
    "pdfjs-dist": "^5.7.284",
    "quill": "^2.0.3",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "react-quill-new": "^3.8.3",
    "tailwindcss": "^4.3.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/quill": "^2.0.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "postcss": "8",
    "prettier": "^3",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "resolutions": {
    "**/glob/minimatch": "^11.0.1",
    "**/test-exclude/minimatch": "^11.0.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "**/next/postcss": "^8.5.23"
  }
}
